<Window x:Class="FitnessApp.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FitnessApp.ViewModels"
        Title="Вход в систему" Height="550" Width="400" 
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Window.DataContext>
        <vm:AuthViewModel/>
    </Window.DataContext>

    <!-- Белая карточка по центру экрана -->
    <Border Background="White" CornerRadius="10" Margin="40" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="15" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="Фитнес-Дневник" FontSize="24" FontWeight="Bold" 
                       Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Вкладки -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="1">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="15,5"/>
                    </Style>
                </TabControl.Resources>

                <!-- ВКЛАДКА 1: ВХОД -->
                <TabItem Header="Вход">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="Логин" Foreground="#576574" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="35" Padding="5,0" FontSize="14" VerticalContentAlignment="Center" 
                                 BorderBrush="#D1D8E0" Margin="0,0,0,15"/>

                        <TextBlock Text="Пароль" Foreground="#576574" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="LoginPasswordBox" 
                                     Height="35" Padding="5,0" FontSize="14" VerticalContentAlignment="Center" 
                                     BorderBrush="#D1D8E0" Margin="0,0,0,15"
                                     PasswordChanged="LoginPasswordBox_PasswordChanged"/>

                        <Button Content="Войти" Command="{Binding LoginActionCommand}" 
                                Height="40" Background="#2ECC71" Foreground="White" 
                                FontSize="16" FontWeight="SemiBold" Cursor="Hand" Margin="0,10,0,0"/>
                    </StackPanel>
                </TabItem>

                <!-- ВКЛАДКА 2: РЕГИСТРАЦИЯ -->
                <TabItem Header="Регистрация">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="Ваше Имя" Foreground="#576574" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="35" Padding="5,0" FontSize="14" VerticalContentAlignment="Center" 
                                     BorderBrush="#D1D8E0" Margin="0,0,0,15"/>

                            <TextBlock Text="Логин" Foreground="#576574" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="35" Padding="5,0" FontSize="14" VerticalContentAlignment="Center" 
                                     BorderBrush="#D1D8E0" Margin="0,0,0,15"/>

                            <TextBlock Text="Пароль" Foreground="#576574" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="RegPasswordBox" 
                                         Height="35" Padding="5,0" FontSize="14" VerticalContentAlignment="Center" 
                                         BorderBrush="#D1D8E0" Margin="0,0,0,15"
                                         PasswordChanged="RegPasswordBox_PasswordChanged"/>

                            <Button Content="Зарегистрироваться" Command="{Binding RegisterActionCommand}" 
                                    Height="40" Background="#3498DB" Foreground="White" 
                                    FontSize="16" FontWeight="SemiBold" Cursor="Hand" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>