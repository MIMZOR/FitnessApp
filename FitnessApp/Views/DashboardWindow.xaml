<Window x:Class="FitnessApp.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-Дневник" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">

    <!-- РЕСУРСЫ ДОЛЖНЫ БЫТЬ СВЕРХУ, ДО ТОГО КАК ИХ ИСПОЛЬЗУЮТ -->
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Убираем стандартную рамку кнопки и делаем скругленные углы -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Эффект при наведении -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Боковое меню -->
            <ColumnDefinition Width="240"/>
            <!-- Рабочая область -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ (SIDEBAR) -->
        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <TextBlock Grid.Row="0" Text="FitnessApp" FontSize="26" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,30,0,40"/>

                <!-- Меню -->
                <StackPanel Grid.Row="1" Margin="10,0">
                    <!-- Улучшенные кнопки: иконка и текст выровнены идеально -->
                    <Button Click="Nav_Click" Tag="Главная" Style="{StaticResource MenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Главная" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="StartWorkout_Click" Style="{StaticResource MenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏋️" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Тренировка" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Schedule_Click" Style="{StaticResource MenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Расписание" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Statistics_Click" Style="{StaticResource MenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Статистика" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Exercises_Click" Style="{StaticResource MenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏃" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Упражнения" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Профиль и выход -->
                <StackPanel Grid.Row="2" Margin="10,0,10,20">
                    <Separator Background="#34495E" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,15">
                        <!-- Аватарка-заглушка -->
                        <Border Width="40" Height="40" CornerRadius="20" Background="#3498DB" Margin="0,0,10,0">
                            <TextBlock Text="U" Foreground="White" FontSize="20" FontWeight="Bold" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding first_name}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding login, StringFormat='@{0}'}" Foreground="#BDC3C7" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Выйти" Click="Logout_Click" Background="#E74C3C" Foreground="White" 
                            BorderThickness="0" Padding="10,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ (КОНТЕНТ) -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок и приветствие -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock x:Name="PageTitle" Text="Главная" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="{Binding first_name, StringFormat='С возвращением, {0}!'}" Foreground="#7F8C8D" FontSize="16" Margin="0,5,0,0">
                    <Run Text="{Binding user_id, Mode=OneWay}" Foreground="#E74C3C" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>

            <!-- Сюда будут загружаться страницы -->
            <ContentControl x:Name="MainContent" Grid.Row="1" Grid.RowSpan="2" Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>